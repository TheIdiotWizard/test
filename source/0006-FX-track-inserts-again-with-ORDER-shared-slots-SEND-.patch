+/* DELAY: a mono tempo-synced delay at half rate (22.05 kHz), 16384 samples (0.74 s, 32 KiB): TIME (the slot's RATE) a
+ * division of the beat, halved until it fits; FDBK (CHAR) the repeats; TONE the wet input's cuts (as ROOM), and every
+ * repeat through a gentle one-pole low-pass. The time glides to a new length (a sample a sample: a tape-like bend, no
+ * click). State: comb[0] the write place, rev_span[0] the target length, pos the length now, damp[0] the repeats' low-pass.
+ * Melodee's own design. */
+#define FX_DLY_N 16384u
+#define FX_DLY_BYTES (FX_DLY_N * 2u)
+static const uint8_t FX_DLY_UNITS[FX_DLY_DIVS] = {3, 4, 6, 8, 9, 12, 16, 18, 24, 32, 36, 48};   /* 24ths of a quarter */
+static uint32_t fx_delay_len(uint32_t div)
+{
+    uint64_t q = (uint64_t)beat_samples() * FX_DLY_UNITS[div < FX_DLY_DIVS ? div : FX_DLY_DEF] / 48u;   /* (half rate) */
+    while (q > FX_DLY_N - 4u) q >>= 1;
+    return q < 8u ? 8u : (uint32_t)q;
+}
+static __attribute__((noinline,section(".audio_text"))) void fx_delay(fx_state_t *restrict f,int16_t *restrict mem,uint32_t n,int32_t target)
+{
+    int32_t mix=f->mix,fb=f->character*215;                  /* (FDBK 127: 0.83) */
+    uint32_t w=f->comb[0]&(FX_DLY_N-1u),len=f->pos?f->pos:f->rev_span[0];
+    for(uint32_t i=0;i<n;i++){
+        if(!f->decim){
+            int32_t in=fx_tone_input(f,fx_div_pow2(fx_left[i]+fx_right[i],1),1.0f/(0.010f*FS/2u));
+            if(len<f->rev_span[0])len++;else if(len>f->rev_span[0])len--;
+            int32_t y=mem[(w-len)&(FX_DLY_N-1u)];
+            f->damp[0]+=fx_div_pow2((y-f->damp[0])*3,2);
+            mem[w]=(int16_t)clamp(fx_div_pow2(in,1)+fx_div_pow2(f->damp[0]*fb,15),-32767,32767);
+            w=(w+1u)&(FX_DLY_N-1u);
+            f->rev_prev_l=f->rev_l;f->rev_l=y*2;
+        }
+        int32_t e=f->decim?fx_div_pow2(f->rev_prev_l+f->rev_l,1):f->rev_l;
+        f->decim^=1u;
+        fx_return(target,FX_DELAY,f->mono,i,e,e,&mix);
+    }
+    f->comb[0]=(uint16_t)w;f->pos=len;f->mix=mix;
+}
