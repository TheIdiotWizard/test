diff --git a/tests/fx_routes_test.c b/tests/fx_routes_test.c
new file mode 100644
index 0000000..f6e05b7
--- /dev/null
+++ b/tests/fx_routes_test.c
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Kerem Kilic (Ellic Studio) */
+/* The FX section's routes: a track's inserts (CHAIN, in ORDER), the shared slots' USE (SEND or MASTER), DELAY (tempo
+ * time, repeats, its 32 KiB tank, one at a time with REVERB's rule) and their persistence in projects and templates. */
+#define UI_TEST_NO_MAIN 1
+#include "ui_test.c"
+#include <assert.h>
+
+static void reset_all(void)
+{
+    ui_power_on();
+    for (uint32_t id = 0; id < RES_COUNT; id++) resource_release(id);
+    memset(fx_state, 0, sizeof fx_state);
+    fx_clear_all();
+    fx_master_use = 0;
+    song.master_q12 = 4096;                                 /* (the host's master pot: up) */
+}
+/* the first block (of 1 / 22.05 kHz pairs) after an impulse where the delay's echo shows, and its size */
+static void delay_echo(uint32_t div, uint32_t *at, int64_t *size, int64_t *second)
+{
+    reset_all();
+    track_t *t = &trk[0];
+    song.g[G_BPM] = 120;
+    t->p[P_FXTYPE] = FX_DELAY; t->p[P_FXMIX] = 127; t->p[P_FXRATE] = (int16_t)div; t->p[P_FXCHAR] = 64; t->p[P_FXTONE] = 0;
+    int32_t b[CTL];
+    uint32_t want = fx_delay_len(div) * 2u, found = 0;
+    int64_t best = 0, next = 0;
+    *at = 0;
+    for (uint32_t f = 0; f < 3u * want + 4u * CTL; f += CTL) {
+        for (uint32_t i = 0; i < CTL; i++) b[i] = f == 0 && i < 8u ? 20000 : 0;
+        assert(fx_process(t, b, CTL));
+        for (uint32_t i = 0; i < CTL; i++) {
+            int64_t a = fx_left[i] < 0 ? -fx_left[i] : fx_left[i];
+            if (f + i > CTL && f + i < want + want / 2u && a > best) { best = a; *at = f + i; found = 1; }
+            if (f + i > want + want / 2u && a > next) next = a;
+        }
+    }
+    assert(found);
+    *size = best; *second = next;
+}
+static void delay_test(void)
+{
+    uint32_t at; int64_t a, b;
+    for (uint32_t div = 2; div < FX_DLY_DIVS; div += 3) {      /* 1/16, 1/16D, 1/4T, 1/2T at 120 BPM */
+        delay_echo(div, &at, &a, &b);
+        uint32_t want = beat_samples() * FX_DLY_UNITS[div] / 48u;   /* (half rate; longer than the tank: halved) */
+        while (want > 16384u - 4u) want >>= 1;
+        want *= 2u;
+        assert(at + 8u >= want && at <= want + 8u);               /* the echo at the division's time (half rate: +-2) */
+        assert(a > 2000 && b > 0 && b < a);                       /* audible, then a smaller repeat (FDBK) */
+        assert(resource[RES_FX0 + FX_TRACK_SI(0, 0)].size == 32768u);
+    }
+    /* 1/2 at 40 BPM is 1.5 s: halved until it fits the 0.74 s tank */
+    song.g[G_BPM] = 40;
+    assert(fx_delay_len(FX_DLY_DIVS - 1u) <= 16384u - 4u && fx_delay_len(FX_DLY_DIVS - 1u) > 8000u);
+    /* MIX 0: dry, the tank given back */
+    trk[0].p[P_FXMIX] = 0;
+    int32_t z[CTL] = {0};
+    for (uint32_t k = 0; k < 64; k++) fx_process(&trk[0], z, CTL);
+    assert(!resource[RES_FX0 + FX_TRACK_SI(0, 0)].size);
+    /* its controls: TIME the divisions, FDBK, TONE */
+    trk[0].p[P_FXTYPE] = FX_DELAY;
+    char v[12]; const char *u;
+    const param_desc_t *d = track_desc(&trk[0], P_FXRATE);
+    assert(str_eq(d->label, "TIME") && d->max == (int16_t)FX_DLY_DIVS - 1);
+    param_format(d, 8, v, &u); assert(str_eq(v, "1/4"));
+    assert(str_eq(track_desc(&trk[0], P_FXCHAR)->label, "FDBK"));
+    puts("DELAY: tempo divisions on time, decaying repeats, a long time halved to fit, 32 KiB given back at MIX 0, TIME/FDBK: OK");
+}
+static void single_test(void)
+{
+    reset_all();
+    /* REVERB / DELAY: one at a time, choosing one takes it from the other rack */
+    song.g[G_MFX2TYPE] = FX_DELAY;
+    go_title("FX"); fx_rack_row[0] = 0;
+    TSEL->p[P_FXTYPE] = FX_REVERB;
+    for (int k = 0; k < 3 && TSEL->p[P_FXTYPE] != FX_DELAY; k++) turn(EN_K1, 1);
+    assert(TSEL->p[P_FXTYPE] == FX_DELAY && song.g[G_MFX2TYPE] == FX_OFF);
+    go_title("SHARED"); fx_rack_row[1] = 2;
+    song.g[G_MFX3TYPE] = FX_REVERB; turn(EN_K1, 1); assert(song.g[G_MFX3TYPE] == FX_DELAY && TSEL->p[P_FXTYPE] == FX_OFF);
+    /* two DELAYs loaded anyway: the second stays silent, the first keeps the tank */
+    reset_all();
+    trk[0].p[P_FXTYPE] = trk[1].p[P_FXTYPE] = FX_DELAY; trk[0].p[P_FXMIX] = trk[1].p[P_FXMIX] = 127;
+    trk[0].p[P_FXRATE] = trk[1].p[P_FXRATE] = 5;
+    int32_t b[CTL]; for (uint32_t i = 0; i < CTL; i++) b[i] = 1000;
+    fx_process(&trk[0], b, CTL); fx_process(&trk[1], b, CTL);
+    assert(resource[RES_FX0 + FX_TRACK_SI(0, 0)].size == 32768u && !resource[RES_FX0 + FX_TRACK_SI(1, 0)].size);
+    puts("REVERB / DELAY: one at a time across the racks, a second one silent: OK");
+}
+static void order_test(void)
+{
+    reset_all();
+    track_t *t = TSEL;
+    int16_t a[FX_PARAMS] = {FX_PHASER, 80, 30, 71}, c[FX_PARAMS] = {FX_CRUSH, 95, 55, 65};
+    memcpy(t->p + P_FXTYPE, a, sizeof a); memcpy(t->p + P_FX3TYPE, c, sizeof c);
+    t->p[P_FXTONE] = 5; t->p[P_FX3TONE] = -9;
+    go_title("FX"); fx_rack_row[0] = 0;
+    int16_t *vp; const param_desc_t *d = page_desc(cur_page(), 2, &vp);
+    assert(d && str_eq(d->label, "ORDER") && *vp == 0);
+    turn(EN_K3, 1);                                         /* PHASER to 2nd */
+    assert(fx_rack_row[0] == 1 && t->p[P_FX2TYPE] == FX_PHASER && t->p[P_FX2MIX] == 80 && t->p[P_FX2TONE] == 5 && !t->p[P_FXTYPE]);
+    turn(EN_K3, 1);                                         /* .. 3rd: CRUSH comes up to 2nd */
+    assert(fx_rack_row[0] == 2 && t->p[P_FX3TYPE] == FX_PHASER && t->p[P_FX2TYPE] == FX_CRUSH && t->p[P_FX2TONE] == -9);
+    turn(EN_K3, 1); assert(fx_rack_row[0] == 2 && t->p[P_FX3TYPE] == FX_PHASER);   /* (the end) */
+    fx_rack_row[0] = 3; d = page_desc(cur_page(), 2, &vp); assert(!d);           /* (the shared row: no ORDER) */
+    /* the order is the sound: PHASER then CRUSH is not CRUSH then PHASER */
+    uint64_t h[2];
+    for (uint32_t k = 0; k < 2; k++) {
+        reset_all(); t = &trk[0];
+        memcpy(t->p + (k ? P_FX2TYPE : P_FXTYPE), a, sizeof a); memcpy(t->p + (k ? P_FXTYPE : P_FX2TYPE), c, sizeof c);
+        h[k] = 1469598103934665603ull;
+        int32_t b[CTL];
+        for (uint32_t f = 0; f < 200; f++) {
+            for (uint32_t i = 0; i < CTL; i++) b[i] = sine_i((f * CTL + i) * 0x01234567u) / 3;
+            assert(fx_process(t, b, CTL));
+            for (uint32_t i = 0; i < CTL; i++) h[k] = (h[k] ^ (uint32_t)fx_left[i]) * 1099511628211ull;
+        }
+    }
+    assert(h[0] != h[1]);
+    puts("ORDER: KNOB 3 moves the effect (all its controls and TONE), the row follows; the order changes the sound: OK");
+}
+static void master_test(void)
+{
+    reset_all();
+    int32_t out[CTL * 2];
+    set_engine_of(&trk[0], ENGI_FM6); apply_preset_to(&trk[0], 8);
+    trk[0].p[P_FXSEND] = 0;                                  /* no send: only MASTER can reach it */
+    song.g[G_MFXTYPE] = FX_CRUSH; song.g[G_MFXMIX] = 127; song.g[G_MFXRATE] = 10; song.g[G_MFXCHAR] = 100;
+    for (uint32_t k = 0; k < 40; k++) mix_block(out, CTL);
+    trk_note_on(&trk[0], 60, 100);
+    uint64_t h[2];
+    for (uint32_t use = 0; use < 2; use++) {
+        fx_master_use = (uint8_t)use; fx_state[0].epoch = fx_epoch - 1u;
+        h[use] = 1469598103934665603ull;
+        for (uint32_t k = 0; k < 200; k++) {
+            mix_block(out, CTL);
+            for (uint32_t i = 0; i < CTL * 2u; i++) { assert(out[i] >= -32767 && out[i] <= 32767); if (k > 40) h[use] = (h[use] ^ (uint32_t)out[i]) * 1099511628211ull; }
+        }
+    }
+    assert(h[0] != h[1]);                                    /* SEND without a send: dry; MASTER: crushed */
+    /* the rack: KNOB 3 on a slot USE; the track's Shared row leaves MASTER slots out (its SEND does not reach them) */
+    reset_all();
+    song.g[G_MFXTYPE] = FX_ROOM; song.g[G_MFX2TYPE] = FX_CRUSH;
+    go_title("SHARED"); fx_rack_row[1] = 1; turn(EN_K3, 1);
+    assert(fx_master_use == 2u);
+    /* persistence: project, template; old firmware refused (a byte it requires 0) */
+    project_t q; project_store_t p; project_capture(&q); assert(q.g[G_RESERVED24] == 2);
+    assert(proj_pack(&p, &q) && proj_import(&proj_scratch, &p, sizeof p) && proj_scratch.g[G_RESERVED24] == 2);
+    fx_master_use = 0; assert(!project_restore_runtime(&proj_scratch) && fx_master_use == 2u && !song.g[G_RESERVED24]);
+    template_save(); fx_master_use = 0; template_load(); assert(fx_master_use == 2u && song.g[G_FXMODE] == 0);
+    song.g[G_FXMODE] = 1; template_save(); fx_master_use = 0; song.g[G_FXMODE] = 0; template_load();
+    assert(fx_master_use == 2u && song.g[G_FXMODE] == 1);
+    ui.confirm = CF_CLEAR_SHARED; ui_confirm_accept();
+    assert(!fx_master_use);
+    puts("MASTER: the whole mix through a shared slot (no send needed), KNOB 3 USE, project/template persistence, Clear: OK");
+}
+static void track_insert_mix_test(void)
+{
+    /* a track's insert in the real mixer: audible, its tail rings on after the note, dry once MIX is 0 */
+    reset_all();
+    int32_t out[CTL * 2];
+    set_engine_of(&trk[0], ENGI_FM6); apply_preset_to(&trk[0], 8);
+    trk[0].p[P_FXTYPE] = FX_DELAY; trk[0].p[P_FXMIX] = 90; trk[0].p[P_FXRATE] = 5; trk[0].p[P_FXCHAR] = 90;
+    for (uint32_t k = 0; k < 40; k++) mix_block(out, CTL);
+    trk_note_on(&trk[0], 60, 100);
+    for (uint32_t k = 0; k < 40; k++) mix_block(out, CTL);
+    trk_note_off(&trk[0], 60);
+    for (uint32_t k = 0; k < 400; k++) mix_block(out, CTL);    /* (the note's release gone) */
+    uint64_t e = 0;
+    for (uint32_t k = 0; k < 200; k++) { mix_block(out, CTL); for (uint32_t i = 0; i < CTL * 2u; i++) e += (uint32_t)abs(out[i]); }
+    assert(e > 0);                                            /* the repeats ring on */
+    trk[0].p[P_FXMIX] = 0;
+    for (uint32_t k = 0; k < 64; k++) mix_block(out, CTL);
+    assert(!resource[RES_FX0 + FX_TRACK_SI(0, 0)].size);
+    puts("Track inserts in the mixer: an audible DELAY, its repeats after the note, given back at MIX 0: OK");
+}
+int main(void)
+{
+    delay_test(); single_test(); order_test(); master_test(); track_insert_mix_test();
+    puts("FX routes: passed");
+    return 0;
+}
