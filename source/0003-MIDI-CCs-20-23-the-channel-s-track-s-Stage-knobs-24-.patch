-/* Fixed CCs, whatever MIDI KNOBS is set to: CC 20..23 turn the FM-1's knobs 1..4 (whatever they edit on the screen
- * shown, as a hand would), CC 24..27 set tracks 1..4's LVL (midi_control.c, as CC 7 sets a channel's own track).
- * Absolute: a value is the knob's place over its range. Knob packets share the panel queue (bit 28: fixed, k: the
- * knob 0..3); a learned CC (MIDI LEARN) still wins */
-#define MIDI_CC_KNOB 20u                         /* CC 20..23: knobs 1..4 */
-#define MIDI_CC_LEVEL 24u                        /* CC 24..27: tracks 1..4's LVL */
+/* Fixed CCs, whatever MIDI KNOBS is set to (a MIDI KNOBS profile's own CCs come first, then MIDI LEARN's), on a
+ * channel ROUT admits to a synth or drum track (a MIDI Track's channel passes them on as before):
+ *   CC 20..23  the four Stage knobs of the channel's track (its engine's knob 1..4), whatever the screen shows:
+ *              absolute, the value is the parameter's place over its range
+ *   CC 24      the channel's track's sound, as PRESETS steps it (its LIST): by the change of the value
+ *              (MIDI MODE ABSOLUTE; a relative MIDI MODE: the encoder's steps)
+ *   CC 91, 93  MIX of the shared (master) rack's REVERB (else ROOM), CHORUS (else PEDAL CHORUS)
+ * The packets share the panel queue: bit 28 fixed, k (bits 7..9) the control (0..3 a knob, MCC_PRESET, MCC_REVERB,
+ * MCC_CHORUS), bits 16..19 the track the channel played when the CC came (ui_midi_knobs.c applies it) */
+#define MIDI_CC_KNOB 20u                         /* CC 20..23: the channel's track's Stage knobs 1..4 */
+#define MIDI_CC_PRESET 24u                       /* CC 24: the channel's track's sound */
+#define MIDI_CC_REVERB 91u
+#define MIDI_CC_CHORUS 93u
+enum { MCC_PRESET = 4u, MCC_REVERB, MCC_CHORUS };
 #define MIDI_KNOB_FIXED (1u << 28)
-static int midi_fixed_knob_receive(uint32_t ch, uint32_t cc, uint32_t value)
+static int midi_fixed_receive(uint32_t ch, uint32_t cc, uint32_t value, uint32_t track)
 {
-    uint32_t k = cc - MIDI_CC_KNOB, w = midi_knob_w;
-    if (k >= 4u) return 0;
+    uint32_t k = cc - MIDI_CC_KNOB < 4u ? cc - MIDI_CC_KNOB : cc == MIDI_CC_PRESET ? MCC_PRESET :
+                 cc == MIDI_CC_REVERB ? MCC_REVERB : cc == MIDI_CC_CHORUS ? MCC_CHORUS : 8u, w = midi_knob_w;
+    if (k >= 8u || track >= NTRK) return 0;
     if (w - midi_knob_r >= MIDI_KNOB_Q) { midi_knob_overflow = 1; return 1; }
     uint32_t src = midi_event_source == 2u ? 1u : 0u, epoch = midi_knob_usb_epoch;
 #if MELODEE_BLE
     if (midi_event_source == 3u) { src = 2u; epoch = midi_knob_ble_epoch; }
 #endif
-    midi_knob_q[w % MIDI_KNOB_Q] = MIDI_KNOB_FIXED | value | k << 7 | ch << 10 | src << 14 | (src == 1u ? 0u : epoch << 20);
+    midi_knob_q[w % MIDI_KNOB_Q] = MIDI_KNOB_FIXED | value | k << 7 | ch << 10 | src << 14 | track << 16 |
+                                   (src == 1u ? 0u : epoch << 20);
     RING_PUBLISH();
     midi_knob_w = w + 1u;
     return 1;
diff --git a/firmware/src/ui_input.c b/firmware/src/ui_input.c
index ecb1562..31b65f0 100644
--- a/firmware/src/ui_input.c
+++ b/firmware/src/ui_input.c
@@ -2151,6 +2151,65 @@ static void mlearn_apply(const mlearn_t *b, uint32_t value)
     song.sel = sel;
     if (b->track == song.sel) ui.force = 1;
 }
+/* CC 20..23: the Stage knob k of track tr (its engine's, as MIDI LEARN binds Stage's knobs), the value absolute */
+static void midi_stage_knob(uint32_t tr, uint32_t k, uint32_t value)
+{
+    __typeof__(song.sel) sel = song.sel;
+    const page_t *over = page_over;
+    song.sel = tr;
+    page_over = stage_page();
+    midi_edit_value = (int32_t)value;
+    edit_param(k, 0);
+    midi_edit_value = -1;
+    page_over = over;
+    song.sel = sel;
+    ui.force = 1;
+}
+/* CC 24: track tr's sound steps by s, as PRESETS steps it (its LIST, all engines then the user presets; wraps) */
+static void midi_track_preset(uint32_t tr, int32_t s)
+{
+    __typeof__(song.sel) sel = song.sel;
+    uint32_t total, cur, n;
+    if (!s || trk_midi_slot(tr)) return;
+    song.sel = tr;
+    cur = list_cur(&total);
+    if (total) {
+        int32_t m = s % (int32_t)total;
+        n = cur >= total ? (s > 0 ? 0u : total - 1u) : (uint32_t)(((int32_t)cur + m + (int32_t)total) % (int32_t)total);
+        if (brw.on && brw.trk == tr) brw.on = 0;     /* (a PRESETS browse of this track waits no longer) */
+        if (n != cur) preset_go(n);
+    }
+    song.sel = sel;
+    ui.force = 1;
+}
+/* CC 91 / 93: the MIX of the shared rack's slot holding want (else alt), 0..127 over MIX's range */
+static void midi_master_fx_mix(int32_t want, int32_t alt, uint32_t value)
+{
+    uint32_t slot, found = FX_SLOTS;
+    for (slot = 0; slot < FX_SLOTS && found == FX_SLOTS; slot++)
+        if (song.g[G_MFXTYPE + slot * FX_PARAMS] == want) found = slot;
+    for (slot = 0; slot < FX_SLOTS && found == FX_SLOTS; slot++)
+        if (song.g[G_MFXTYPE + slot * FX_PARAMS] == alt) found = slot;
+    if (found == FX_SLOTS) return;                     /* (no such effect in the rack: nothing to set) */
+    const param_desc_t *d = global_desc(G_MFXMIX + found * FX_PARAMS);
+    song.g[G_MFXMIX + found * FX_PARAMS] = (int16_t)(d->min + (int32_t)(value * (uint32_t)(d->max - d->min) / 127u));
+    ui.force = 1;
+}
+static void midi_fixed_apply(uint32_t k, uint32_t tr, uint32_t v, uint32_t src, uint32_t ch)
+{
+    static uint8_t last[NTRK], seen;                   /* CC 24: the last value per track (ABSOLUTE) */
+    if (tr >= trk_n()) return;
+    if (k < 4u) midi_stage_knob(tr, k, v);
+    else if (k == MCC_PRESET) {
+        uint32_t mode = settings_midi_knob_mode;
+        int32_t s = mode != MK_ABSOLUTE ? midi_knob_relative(v, mode) : (seen >> tr) & 1u ? (int32_t)v - last[tr] : 0;
+        last[tr] = (uint8_t)v;
+        seen |= (uint8_t)(1u << tr);
+        midi_track_preset(tr, s);
+    } else if (k == MCC_REVERB) midi_master_fx_mix(FX_REVERB, FX_ROOM, v);
+    else if (k == MCC_CHORUS) midi_master_fx_mix(FX_CHORUS, FX_PEDAL_CHORUS, v);
+    (void)src; (void)ch;
+}
 static void mlearn_poll(void)
 {
     int32_t cc = mlearn_seen;
