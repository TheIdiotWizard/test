@@ -136,10 +137,22 @@ static int settings_import(persist_t *p, int n)
     panel = p->panel.magic == PANEL_MAGIC ? p->panel : PANEL_DEFAULT;
     {
         const uint8_t *w = p->favorites.factory[VOICE_PREF_ROW] + VOICE_PREF_BYTE;
