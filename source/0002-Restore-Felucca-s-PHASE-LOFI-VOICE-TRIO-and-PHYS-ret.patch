diff --git a/firmware/src/eng_fphase.c b/firmware/src/eng_fphase.c
new file mode 100644
index 0000000..9ea3aef
--- /dev/null
+++ b/firmware/src/eng_fphase.c
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Kerem Kilic (Ellic Studio)
+ * Portions Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments
+ * (Felucca-Engines, MIT: LICENSES/MIT-Felucca-Engines.txt) */
+/* PHASE as Felucca ships it (Felucca-Engines eng_phase.c, MIT, with FOLD on E7), restored in Melodee at its
+ * original engine ID 2. Melodee's own eng_phase.c became the CZ-1's core, so this copy's names carry an f (fpd_,
+ * fph_, ENG_FPHASE). Changes for Melodee: the tuned pitch (tuned_pitch_inc: TUNE, A4, the scales), line 2 following
+ * line 1's fine pitch (cents_inc, as TRIO's lines do) and presets without effects or patterns. */
+/* PHASE: phase distortion. Felucca's own design.
+ *
+ * Waveforms: a -cos table read through a bent phase whose bend is DCW (SAW, SQR, PLS, DSIN, SPLS), or a
+ * sine windowed by a saw, a triangle or a trapezoid whose pitch rises with DCW (RSAW, RTRI, RTRP). WAVE2
+ * alternates with WAVE every other cycle. A second line (DTN) can be mixed or ring-modulated; SUB adds
+ * a sine an octave down. ENV moves DCW with the voice's envelope.
+ * FOLD (E7): a sine wavefolder on the voice, after the lines and before SUB and the amp. 0 is off (the
+ * loop and the sound without it). Up from 0 a soft sine saturation, then folds: the gain rises to ~8x
+ * (four folds of a full-scale wave). Alias-aware: the sine fold has no corners (a triangle fold's sharp
+ * edges are what alias most), and above A4 the gain added past the saturation falls with the pitch
+ * (1/f), so the top notes fold less. */
+static const char *const N_FPD_WAVE[] = {"SAW", "SQR", "PLS", "DSIN", "SPLS", "RSAW", "RTRI", "RTRP"};
+static const char *const N_FPD_WAVE2[] = {"-", "SAW", "SQR", "PLS", "DSIN", "SPLS", "RSAW", "RTRI", "RTRP"};
+static const char *const N_FPD_LINE[] = {"MIX", "RING"};
+
+static inline int32_t fpd_cos(uint32_t ph16)             /* -cos, Q15, from the 16-bit PD phase */
+{
+    return -sine_i(((ph16 & 0xFFFFu) << 16) + 0x40000000u);
+}
+
+/* one wave's bend for a block: break points and the slopes of the bent phase
+ * (Q16 reciprocals), so a sample costs a multiply instead of a divide (the
+ * bent phase comes out the same or 1 lower in 65536) */
+typedef struct {
+    uint32_t w, x, peak, rez;
+    uint32_t k0, k1;
+} fpd_t;
+
+static inline uint32_t fpd_slope(uint32_t span, uint32_t len) { return (span << 16) / (len ? len : 1u); }
+
+static void fpd_setup(fpd_t *b, uint32_t w, uint32_t dcw)
+{
+    uint32_t x;
+    b->w = w;
+    switch (w) {
+    case 0:                                                  /* SAW */
+        x = 32768u + ((dcw * 32767u) >> 16);
+        b->k0 = fpd_slope(32768u, x);
+        b->k1 = fpd_slope(32767u, 65535u - x);
+        break;
+    case 1:                                                  /* SQUARE */
+        x = 32768u - ((dcw * 31120u) >> 16);
+        b->k0 = fpd_slope(32768u, x);
+        b->k1 = fpd_slope(32767u, x);
+        break;
+    case 2:                                                  /* PULSE */
+        x = 65535u - ((dcw * 63487u) >> 16);
+        b->k0 = fpd_slope(65535u, x);
+        break;
+    case 3:                                                  /* DOUBLE SINE */
+        x = 65535u - ((dcw * 49151u) >> 16);
+        b->k0 = fpd_slope(65535u, x);
+        b->k1 = fpd_slope(65535u, 65535u - x);
+        break;
+    case 4:                                                  /* SAW-PULSE */
+        x = 65535u - ((dcw * 32767u) >> 16);
+        b->peak = (x * (32768u + ((dcw * 29491u) >> 16))) >> 16;
+        if (!b->peak)
+            b->peak = 1;
+        b->k0 = fpd_slope(32768u, b->peak);
+        b->k1 = fpd_slope(32767u, x - b->peak);
+        break;
+    default:                                                 /* RESONANCE */
+        x = 0;
+        b->rez = (dcw * 44000u) >> 16;
+        break;
+    }
+    b->x = x;
+}
+
+/* one sample at phase ph (16 bit): bipolar Q15 */
+static int32_t fpd_wave(const fpd_t *b, uint32_t ph)
+{
+    uint32_t pd, x = b->x;
+    switch (b->w) {
+    case 0:                                                  /* SAW */
+        pd = ph < x ? (ph * b->k0) >> 16 : 32768u + (((ph - x) * b->k1) >> 16);
+        break;
+    case 1:                                                  /* SQUARE */
+        if (ph < x)
+            pd = (ph * b->k0) >> 16;
+        else if (ph < 32768u)
+            pd = 32768u;
+        else if (ph < 32768u + x)
+            pd = 32768u + (((ph - 32768u) * b->k1) >> 16);
+        else
+            pd = 65535u;
+        break;
+    case 2:                                                  /* PULSE */
+        pd = ph < x ? (ph * b->k0) >> 16 : 65535u;
+        break;
+    case 3:                                                  /* DOUBLE SINE */
+        pd = ph < x ? (ph * b->k0) >> 16 : ((ph - x) * b->k1) >> 16;
+        break;
+    case 4:                                                  /* SAW-PULSE */
+        if (ph >= x)
+            pd = 65535u;
+        else if (ph < b->peak)
+            pd = (ph * b->k0) >> 16;
+        else
+            pd = 32768u + (((ph - b->peak) * b->k1) >> 16);
+        break;
+    default: {                                               /* RESONANCE: windowed sine, rez = pitch of the core */
+        uint32_t rp = (ph + ((ph * b->rez) >> 16) * 7u) & 0xFFFFu, win;
+        int32_t core = (fpd_cos(rp) * 5) >> 3;
+        if (b->w == 5)
+            win = 65535u - ph;                               /* saw window */
+        else if (b->w == 6)
+            win = ph < 32768u ? ph << 1 : (65535u - ph) << 1; /* triangle window */
+        else
+            win = ph < 16384u ? ph << 2 : ph > 49152u ? (65535u - ph) << 2 : 65535u;   /* trapezoid */
+        if (win > 65535u)
+            win = 65535u;
+        return (core * (int32_t)win) >> 16;                  /* |core| <= 20479: fits 32 bits */
+    }
+    }
+    return fpd_cos(pd);
+}
+
+/* s[4] at FOLD 0: the last block had no fold (fph_render: a FOLD going on or off crossfades a block) */
+#define FPD_UNFOLDED (-2147483647 - 1)
+
+static void fph_note_on(track_t *t, voice_t *v)
+{
+    v->ph[1] = 0;
+    v->ph[2] = 0;
+    v->s[0] = 0;                 /* WAVE / WAVE2 toggle, line 1 */
+    v->s[1] = 0;                 /* line 2 */
+    v->s[4] = t->p[P_E7] > 0 ? 0 : FPD_UNFOLDED;   /* FOLD's DC blocker (only FOLD > 0 reads them; kept on a */
+    v->s[5] = 0;                                   /* retrigger: .keep) */
+    v->s[6] = 163;               /* FOLD's last gain (fph_xfade): FOLD 1's, FPD_FOLD_G0, until a folded block */
+}
+
+/* FOLD's gain (Q8) for a block: 0.64x at FOLD 1 (sin(pi/2 x) then has a small-signal gain of 1: a soft saturation),
+ * ~8x at 127; the part above 0.64x scaled by A4 / the note's pitch above A4 (FPD_FOLD_REF: 440 Hz, 42852281 at
+ * 44.1 kHz) */
+#define FPD_FOLD_G0 163u
+#define FPD_FOLD_REF ((uint32_t)((440ull << 32) / FS))
+static inline uint32_t fpd_fold_gain(uint32_t fold, uint32_t inc)
+{
+    uint32_t ext = fold * ((2048u - FPD_FOLD_G0) << 4) / 127u;          /* Q12, <= 30160 */
+    if (inc > FPD_FOLD_REF)
+        ext = ext * (FPD_FOLD_REF >> 12) / (inc >> 12);              /* < 2^32 */
+    return FPD_FOLD_G0 + (ext >> 4);
+}
+
+/* the loop: fg 0 (a constant: fph_render's loop, the code as it always was), fg > 0 the fold gain (fph_render_f's
+ * own copy: the loop without FOLD gains nothing) */
+static inline __attribute__((always_inline)) void fph_loop(track_t *t, voice_t *v, int32_t *out, uint32_t n,
+                                                            const vmod_t *m, uint32_t fg)
+{
+    const int16_t *p = t->p;
+    uint32_t w1 = (uint32_t)p[P_E0] & 7u, w2 = (uint32_t)p[P_E1], i;
+    int32_t depth = (p[P_E2] << 8) + m->cutoff + mulq15(m->envq15, p[P_E3] * 256);
+    uint32_t dcw, inc = m->inc, inc2;
+    int32_t det = p[P_E4], line2 = det != 0 || p[P_E5], ring = p[P_E5], sub = p[P_E6] * 200;
+    uint32_t ph0 = v->ph[0], ph1 = v->ph[1], ph2 = v->ph[2];
+    int32_t tg0 = v->s[0], tg1 = v->s[1];                    /* WAVE / WAVE2 toggles */
+    int32_t fx1 = fg ? v->s[4] : 0, fhp = fg ? v->s[5] : 0;  /* FOLD's DC blocker: the last fold, its output */
+    fpd_t b1, b2;
+    depth = clamp(depth + (m->shape - (64 << 8)), 0, 127 << 8);
+    dcw = (uint32_t)depth * 65535u / (127u << 8);
+    dcw = (dcw * 56000u) >> 16;                              /* the classic range of the bend */
+    {   /* (Melodee) line 2 follows line 1's fine pitch (bend, the scale's cents) as TRIO's do: DTN in cents on top */
+        uint32_t base = tuned_pitch_inc(m->pitch16);
+        int32_t fine = (base >> 12) ? (int32_t)(inc - base) / (int32_t)(base >> 12) : 0;
+        inc2 = cents_inc(m->pitch16, det, fine);
+    }
+    fpd_setup(&b1, w1, dcw);
+    fpd_setup(&b2, w2 ? w2 - 1u : w1, dcw);                   /* WAVE2 (every other cycle) */
+    for (i = 0; i < n; i++) {
+        uint32_t old = ph0;
+        int32_t s;
+        s = fpd_wave(tg0 ? &b2 : &b1, ph0 >> 16);
+        ph0 += inc;
+        if (ph0 < old)
+            tg0 ^= 1;
+        if (line2) {
+            uint32_t old2 = ph1;
+            int32_t s2 = fpd_wave(tg1 ? &b2 : &b1, ph1 >> 16);
+            ph1 += inc2;
+            if (ph1 < old2)
+                tg1 ^= 1;
+            s = ring ? mulq15(s, s2) : (s + s2) >> 1;     /* both within +-32767 */
+        }
+        if (fg) {   /* sin(pi/2 s gain): full scale x1 is a quarter turn; then a DC blocker (~14 Hz): folding a wave
+                     * that sits off centre (PLS, RING, the RESO windows) moves its DC around */
+            int32_t f = sine_i((uint32_t)(s * (int32_t)fg) << 7);
+            fhp += f - fx1 - (fhp >> 9);
+            fx1 = f;
+            s = fhp;
+        }
+        if (sub) {
+            ph2 += inc >> 1;
+            s += mulq15(osc_sine(ph2), sub);
+        }
+        if (fg)     /* (the blocker's step of a full-scale swing, +-65534, and SUB's 25400 on it: s x amp would wrap
+                     * 32 bits past 65538; FOLD 0 stays within 58167) */
+            s = clamp(s, -65535, 65535);
+        out[i] += voice_amp(s, m, i) * 2;
+    }
+    v->ph[0] = ph0;
+    v->ph[1] = ph1;
+    v->ph[2] = ph2;
+    v->s[0] = tg0;
+    v->s[1] = tg1;
+    if (fg) {
+        v->s[4] = fx1;
+        v->s[5] = fhp;
+        v->s[6] = (int32_t)fg;
+    }
+}
+static __attribute__((noinline)) void fph_render_f(track_t *t, voice_t *v, int32_t *out, uint32_t n, const vmod_t *m)
+{
+    fph_loop(t, v, out, n, m, fpd_fold_gain((uint32_t)t->p[P_E7], m->inc));
+}
+
+/* FOLD going on or off (a knob, LFO / MOD, automation): FOLD 0 has no DC blocker (the sound without FOLD) and the
+ * fold's output has none of the wave's DC, so the switch would step (up to half full scale on PLS / RING). That block
+ * is rendered both ways and crossfaded, unfolded -> folded or back (going off: at the last FOLD's gain); going on, the
+ * blocker starts afresh as on a note-on (its state from the last FOLD long gone). Once per switch: not the loop's cost */
+static int32_t fpd_xa[CTL], fpd_xb[CTL];
+static __attribute__((noinline)) void fph_xfade(track_t *t, voice_t *v, int32_t *out, uint32_t n, const vmod_t *m,
+                                                  uint32_t on)
+{
+    uint32_t ph0 = v->ph[0], ph1 = v->ph[1], ph2 = v->ph[2], i;
+    int32_t tg0 = v->s[0], tg1 = v->s[1], k;
+    if (n > CTL)
+        n = CTL;
+    for (i = 0; i < n; i++)
+        fpd_xa[i] = fpd_xb[i] = 0;
+    fph_loop(t, v, fpd_xa, n, m, 0);                               /* unfolded; then from the same phases: */
+    v->ph[0] = ph0;
+    v->ph[1] = ph1;
+    v->ph[2] = ph2;
+    v->s[0] = tg0;
+    v->s[1] = tg1;
+    if (on) {
+        v->s[4] = v->s[5] = 0;
+        fph_render_f(t, v, fpd_xb, n, m);
+    } else {
+        fph_loop(t, v, fpd_xb, n, m, (uint32_t)v->s[6]);          /* (s[6]: set with the last folded block) */
+        v->s[4] = FPD_UNFOLDED;
+    }
+    for (i = 0; i < n; i++) {
+        k = (int32_t)(on ? i + 1u : n - 1u - i);                    /* the folded one's share, of n */
+        out[i] += fpd_xa[i] + (fpd_xb[i] - fpd_xa[i]) * k / (int32_t)n;
+    }
+}
+
+static void fph_render(track_t *t, voice_t *v, int32_t *out, uint32_t n, const vmod_t *m)
+{
+    if (t->p[P_E7] > 0) {
+        if (v->s[4] == FPD_UNFOLDED)
+            fph_xfade(t, v, out, n, m, 1);
+        else
+            fph_render_f(t, v, out, n, m);
+    } else if (v->s[4] != FPD_UNFOLDED) {
+        fph_xfade(t, v, out, n, m, 0);
+    } else {
+        fph_loop(t, v, out, n, m, 0);
+    }
+}
+
+static const preset_t FPHASE_PRESETS[] = {
+    /* name, {WAVE, WAVE2, DCW, ENV, DTN, LINE, SUB, FOLD}, {A D S R}, fenv, mono */
+    {"BRASS", {0, 0, 30, 90, 0, 0, 0, 0}, {8, 70, 90, 40}, 0, 0},
+    {"ORGAN", {3, 0, 40, 0, 0, 0, 0, 0}, {0, 127, 127, 30}, 0, 0},
+    {"STRING", {0, 4, 50, 40, 12, 0, 0, 0}, {40, 90, 100, 70}, 0, 0},
+    {"RESO", {5, 0, 60, 60, 0, 0, 0, 0}, {0, 70, 30, 60}, 0, 0},
+    {"BELL", {6, 0, 80, 50, 0, 0, 0, 0}, {0, 95, 0, 90}, 0, 0},
+    {"WIRE", {4, 7, 70, 40, 7, 0, 0, 0}, {10, 80, 80, 60}, 0, 0},
+};
+
+static const engine_t ENG_FPHASE = {
+    .name = "PHASE",
+    .page_title = {"PHS", "LINE"},
+    .edit = {
+        {"WAVE", F_ENUM, 0, 7, 0, N_FPD_WAVE, 0},
+        {"WAVE2", F_ENUM, 0, 8, 0, N_FPD_WAVE2, 0},
+        {"DCW", F_PCT, 0, 127, 60, 0, 0},
+        {"ENV", F_PCT, 0, 127, 64, 0, 0},
+        {"DTN", F_INT, 0, 127, 0, 0, "ct"},
+        {"LINE", F_ENUM, 0, 1, 0, N_FPD_LINE, 0},
+        {"SUB", F_PCT, 0, 127, 0, 0, 0},
+        {"FOLD", F_PCT, 0, 127, 0, 0, 0},       /* 0 = off */
+    },
+    .presets = FPHASE_PRESETS,
+    .npresets = NELEM(FPHASE_PRESETS),
+    .note_on = fph_note_on,
+    .render = fph_render,
+    .keep = 0x30,                /* FOLD's DC blocker: a retrigger does not restart it */
+    .knob = {P_E2, P_E3, P_E4, P_REL},
+};
